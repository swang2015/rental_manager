generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleType {
  OWNER
  TENANT
  VENDOR
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum TenantStatus {
  ACTIVE
  ARCHIVED
}

enum VendorStatus {
  ACTIVE
  ARCHIVED
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  OFF_MARKET
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum WorkOrderStatus {
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  phone         String?
  timezone      String       @default("UTC")
  isSuperAdmin  Boolean      @default(false)
  status        UserStatus   @default(ACTIVE)
  requestedRole UserRoleType?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  roles            UserRole[]
  sessions         Session[]
  properties       Property[]           @relation("PropertyOwner")
  tenantDirectory  Tenant[]             @relation("TenantOwner")
  tenancies        Tenant[]             @relation("TenantUser")
  vendors          Vendor[]             @relation("VendorUser")
  invitationsSent  Invitation[]         @relation("InvitationSender")
  invitationsOwned Invitation[]         @relation("InvitationOwner")
  paymentsRecorded Payment[]            @relation("PaymentRecorder")
  adjustments      Adjustment[]         @relation("AdjustmentCreator")
  requestsCreated  MaintenanceRequest[] @relation("RequestCreator")
  workOrderEvents  WorkOrderEvent[]     @relation("WorkOrderEventActor")
  requestEvents    RequestEvent[]       @relation("RequestEventActor")

  @@index([status, isSuperAdmin])
}

model UserRole {
  id        String       @id @default(cuid())
  userId    String
  role      UserRoleType
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id              String       @id @default(cuid())
  email           String
  role            UserRoleType
  ownerUserId     String?
  tokenHash       String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime     @default(now())

  owner     User? @relation("InvitationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([ownerUserId, role, acceptedAt])
}

model Tenant {
  id             String       @id @default(cuid())
  ownerUserId    String
  userId         String
  name           String
  email          String
  phone          String?
  status         TenantStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner    User   @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  user     User   @relation("TenantUser", fields: [userId], references: [id], onDelete: Cascade)
  leases   Lease[]
  requests MaintenanceRequest[]

  @@unique([ownerUserId, userId])
  @@index([ownerUserId, status])
  @@index([userId])
}

model Vendor {
  id        String       @id @default(cuid())
  userId    String       @unique
  name      String
  company   String?
  trade     String?
  phone     String?
  status    VendorStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user       User        @relation("VendorUser", fields: [userId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([status, trade])
  @@index([name])
}

model Property {
  id             String    @id @default(cuid())
  ownerUserId    String
  name           String
  addressLine1   String
  city           String
  region         String
  postalCode     String
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner User   @relation("PropertyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  units Unit[]

  @@index([ownerUserId, archivedAt])
  @@index([ownerUserId, name])
}

model Unit {
  id              String     @id @default(cuid())
  ownerUserId     String
  propertyId      String
  label           String
  bedrooms        Int
  bathrooms       Float
  rentAmountCents Int
  status          UnitStatus @default(AVAILABLE)
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases   Lease[]
  requests MaintenanceRequest[]

  @@unique([propertyId, label])
  @@index([ownerUserId, status])
  @@index([ownerUserId, propertyId])
}

model Lease {
  id                 String      @id @default(cuid())
  ownerUserId        String
  unitId             String
  tenantId           String
  startDate          DateTime    @db.Date
  endDate            DateTime    @db.Date
  rentAmountCents    Int
  depositAmountCents Int
  dueDay             Int
  status             LeaseStatus @default(DRAFT)
  terminationReason  String?
  predecessorLeaseId String?     @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  charges     RentCharge[]
  predecessor Lease?      @relation("LeaseRenewal", fields: [predecessorLeaseId], references: [id], onDelete: SetNull)
  successor   Lease?      @relation("LeaseRenewal")

  @@index([ownerUserId, status])
  @@index([ownerUserId, unitId])
  @@index([ownerUserId, tenantId])
}

model RentCharge {
  id             String   @id @default(cuid())
  ownerUserId    String
  leaseId        String
  periodStart    DateTime @db.Date
  dueDate        DateTime @db.Date
  amountCents    Int
  balanceCents   Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments    Payment[]
  adjustments Adjustment[]

  @@unique([leaseId, periodStart])
  @@index([ownerUserId, dueDate])
  @@index([ownerUserId, balanceCents])
}

model Payment {
  id               String        @id @default(cuid())
  ownerUserId      String
  chargeId         String
  amountCents      Int
  paidOn           DateTime      @db.Date
  method           PaymentMethod
  reference        String?
  recordedByUserId String
  createdAt        DateTime      @default(now())

  charge     RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, paidOn])
  @@index([chargeId])
}

model Adjustment {
  id              String   @id @default(cuid())
  ownerUserId     String
  chargeId        String
  amountCents     Int
  reason          String
  createdByUserId String
  createdAt       DateTime @default(now())

  charge    RentCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  createdBy User       @relation("AdjustmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, createdAt])
  @@index([chargeId])
}

model MaintenanceRequest {
  id              String              @id @default(cuid())
  ownerUserId     String
  unitId          String
  tenantId        String
  category        String
  description     String
  priority        MaintenancePriority @default(MEDIUM)
  status          MaintenanceStatus   @default(OPEN)
  triageNote      String?
  cancelledReason String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  unit      Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?       @relation("RequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?
  events    RequestEvent[]

  @@index([ownerUserId, status, priority])
  @@index([ownerUserId, unitId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  ownerUserId    String
  requestId      String          @unique
  vendorId       String?
  scheduledFor   DateTime?       @db.Date
  status         WorkOrderStatus @default(SCHEDULED)
  resolutionNote String?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor  Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  events  WorkOrderEvent[]

  @@index([ownerUserId, status])
  @@index([ownerUserId, vendorId])
}

model WorkOrderEvent {
  id             String           @id @default(cuid())
  ownerUserId    String
  workOrderId    String
  fromStatus     WorkOrderStatus?
  toStatus       WorkOrderStatus
  note           String?
  actorUserId    String
  createdAt      DateTime         @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User      @relation("WorkOrderEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workOrderId, createdAt])
}

model RequestEvent {
  id             String             @id @default(cuid())
  ownerUserId    String
  requestId      String
  fromStatus     MaintenanceStatus?
  toStatus       MaintenanceStatus
  note           String?
  actorUserId    String?
  createdAt      DateTime           @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?              @relation("RequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}
