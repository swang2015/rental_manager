# Copy to .env and adjust for your machine.
# Local Node development and Prisma CLI use DATABASE_URL.
# On Cloudflare Workers, the HYPERDRIVE binding is used instead.
DATABASE_URL="postgresql://USER@localhost:5432/rental_manager?schema=public"
APP_URL="http://localhost:3000"
SESSION_COOKIE_SECURE="false"
CRON_SECRET="change-me"
